import { useEffect, useState } from "react";
import { invoke } from "@tauri-apps/api/core";
import { Play, Square, RotateCw, Trash2, Activity, ShieldAlert } from "lucide-react";
// Importamos los modales directamente desde Monitor.tsx
import { MonitorModal, SecurityTestModal } from "@/components/Monitor";

interface ContainerListProps {
  refreshTrigger: number;
}

export function ContainerList({ refreshTrigger }: ContainerListProps) {
  const [containers, setContainers] = useState<any[]>([]);
  // Estados para abrir los modales
  const [monitorId, setMonitorId] = useState<string | null>(null);
  const [monitorName, setMonitorName] = useState("");
  const [testId, setTestId] = useState<string | null>(null);
  const [testName, setTestName] = useState("");

  const fetchContainers = async () => {
    try {
      const data = await invoke<any[]>("get_containers");
      setContainers(data);
    } catch (err) {
      console.error(err);
    }
  };

  useEffect(() => {
    fetchContainers();
    const interval = setInterval(fetchContainers, 2000);
    return () => clearInterval(interval);
  }, [refreshTrigger]);

  const handleAction = async (id: string, action: string) => {
    try {
      await invoke("perform_action", { id, action });
      fetchContainers();
    } catch (err) {
      console.error(err);
    }
  };

  return (
    <>
      <div className="bg-zinc-900 border border-zinc-800 rounded-xl shadow-lg overflow-hidden">
        <div className="p-4 border-b border-zinc-800 flex justify-between items-center">
          <h3 className="font-bold text-white">Contenedores Activos</h3>
          <span className="text-xs bg-zinc-950 text-zinc-500 px-2 py-1 rounded border border-zinc-800 font-mono">
            {containers.length} Total
          </span>
        </div>

        <div className="divide-y divide-zinc-800">
          {containers.length === 0 ? (
            <div className="p-10 text-center text-zinc-600 text-sm">
              No hay contenedores corriendo. Crea uno nuevo.
            </div>
          ) : (
            containers.map((c) => (
              <div key={c.id} className="p-4 flex items-center justify-between hover:bg-zinc-800/40 transition-colors">
                {/* Info Contenedor */}
                <div className="flex items-center gap-4">
                  <div className={`w-3 h-3 rounded-full shadow-[0_0_12px_rgba(0,0,0,0.5)] ${c.status === 'running' ? 'bg-emerald-500 shadow-emerald-500/50' : 'bg-red-500'}`} />
                  <div>
                    <p className="text-sm font-semibold text-white">{c.name}</p>
                    <p className="text-xs text-zinc-500 font-mono">{c.short_id} • {c.status}</p>
                  </div>
                </div>

                {/* Botones de Acción */}
                <div className="flex items-center gap-1">
                  {c.status === 'running' ? (
                    <>
                      <ActionButton 
                        onClick={() => { setMonitorId(c.id); setMonitorName(c.name); }} 
                        icon={<Activity size={16} />} 
                        color="text-blue-400 bg-blue-400/10 hover:bg-blue-400/20" 
                        title="Monitor en Tiempo Real"
                      />
                      <ActionButton 
                        onClick={() => { setTestId(c.id); setTestName(c.name); }} 
                        icon={<ShieldAlert size={16} />} 
                        color="text-orange-400 bg-orange-400/10 hover:bg-orange-400/20" 
                        title="Test de Seguridad (FS)"
                      />
                      <div className="w-px h-6 bg-zinc-800 mx-2"></div>
                      <ActionButton onClick={() => handleAction(c.id, "restart")} icon={<RotateCw size={16} />} color="text-yellow-400 hover:bg-zinc-800" title="Reiniciar" />
                      <ActionButton onClick={() => handleAction(c.id, "stop")} icon={<Square size={16} />} color="text-red-400 hover:bg-zinc-800" title="Detener" />
                    </>
                  ) : (
                    <>
                      <ActionButton onClick={() => handleAction(c.id, "start")} icon={<Play size={16} />} color="text-emerald-400 hover:bg-zinc-800" title="Iniciar" />
                      <ActionButton onClick={() => handleAction(c.id, "delete")} icon={<Trash2 size={16} />} color="text-zinc-500 hover:text-red-400 hover:bg-zinc-800" title="Eliminar" />
                    </>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      {/* Modales Flotantes */}
      {monitorId && (
        <MonitorModal id={monitorId} name={monitorName} onClose={() => setMonitorId(null)} />
      )}
      {testId && (
        <SecurityTestModal id={testId} name={testName} onClose={() => setTestId(null)} />
      )}
    </>
  );
}

// Botón simple reutilizable
function ActionButton({ onClick, icon, color, title }: any) {
  return (
    <button 
      onClick={onClick} 
      title={title}
      className={`p-2 rounded-lg transition-all ${color}`}
    >
      {icon}
    </button>
  );
}
</file>

