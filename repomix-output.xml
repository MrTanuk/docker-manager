              {details.name}
              <span className={`text-xs px-2 py-0.5 rounded-full border ${details.state === 'running' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-red-500/10 text-red-400'}`}>
                {details.state.toUpperCase()}
              </span>
            </h2>
            <p className="text-xs text-zinc-500 font-mono mt-1">ID: {details.id}</p>
          </div>
          <div className="text-right">
             <p className="text-xs text-zinc-500">Host PID (Namespace Root)</p>
             <p className="text-xl font-mono text-blue-400">{details.pid_host}</p>
          </div>
        </div>
        
        {/* Tabs */}
        <div className="flex gap-4 mt-6 border-b border-zinc-800">
          {['overview', 'resources', 'storage'].map(tab => (
            <button
              key={tab}
